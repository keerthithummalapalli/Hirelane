# ==============================================================================
# HireLane Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your credentials.

# 1. Supabase Credentials (Required for Auth, Database, and Storage)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Resend Email Service (Required for Real Email Reminders)
# Sign up free at https://resend.com and grab your API key
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=HireLane <reminders@yourdomain.com>

# 3. Cron Scheduler Security Key
# Required to authenticate automated reminder processing (e.g. from GitHub Actions, Vercel Cron, or Supabase pg_cron)
CRON_SECRET=hirelane_cron_secret_key_12345

# 4. Optional AI Extraction (Optional - Fallback deterministic parser works without this)
# OpenAI or Anthropic key if you wish to enable advanced LLM job-description extraction
OPENAI_API_KEY=
